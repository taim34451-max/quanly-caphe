<%@ page pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách Đơn hàng | Barista Hub</title>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom Style CSS -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/views/assets/css/style.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar Component -->
        <jsp:include page="/views/common/sidebar.jsp" />
        
        <!-- Main Content Area -->
        <main class="main-content">
            <div class="header-panel">
                <div>
                    <h1 class="header-title"><i class="fas fa-list-alt"></i> Danh Sách Đơn Hàng</h1>
                    <p class="header-subtitle">Xem toàn bộ lịch sử đơn hàng và lọc theo trạng thái pha chế.</p>
                </div>
            </div>

            <!-- Table Panel -->
            <div class="table-panel">
                <!-- Status Filter Bar -->
                <div class="table-filter-bar">
                    <a href="${pageContext.request.contextPath}/barista/orders?status=ALL" 
                       class="filter-tab ${currentStatus == 'ALL' ? 'active' : ''}">
                        <i class="fas fa-border-all"></i> Tất cả (${counts['PENDING'] + counts['MAKING'] + counts['COMPLETED'] + counts['CANCELLED']})
                    </a>
                    
                    <a href="${pageContext.request.contextPath}/barista/orders?status=PENDING" 
                       class="filter-tab ${currentStatus == 'PENDING' ? 'active' : ''}">
                        <i class="fas fa-hourglass-start" style="color: var(--status-pending);"></i> Đơn Mới (${counts['PENDING'] != null ? counts['PENDING'] : 0})
                    </a>
                    
                    <a href="${pageContext.request.contextPath}/barista/orders?status=MAKING" 
                       class="filter-tab ${currentStatus == 'MAKING' ? 'active' : ''}">
                        <i class="fas fa-sync fa-spin" style="color: var(--status-making);"></i> Đang Pha (${counts['MAKING'] != null ? counts['MAKING'] : 0})
                    </a>
                    
                    <a href="${pageContext.request.contextPath}/barista/orders?status=COMPLETED" 
                       class="filter-tab ${currentStatus == 'COMPLETED' ? 'active' : ''}">
                        <i class="fas fa-check-circle" style="color: var(--status-completed);"></i> Hoàn Thành (${counts['COMPLETED'] != null ? counts['COMPLETED'] : 0})
                    </a>
                    
                    <a href="${pageContext.request.contextPath}/barista/orders?status=CANCELLED"
                       class="filter-tab ${currentStatus == 'CANCELLED' ? 'active' : ''}">
                        <i class="fas fa-times-circle" style="color: var(--status-cancelled);"></i> Đã Hủy (${counts['CANCELLED'] != null ? counts['CANCELLED'] : 0})
                    </a>
                </div>

                <!-- Orders Table -->
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Khách Hàng</th>
                            <th>Số Bàn</th>
                            <th>Trạng Thái</th>
                            <th>Thời Gian Đặt</th>
                            <th>Tổng Tiền</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <c:choose>
                            <c:when test="${empty orders}">
                                <tr>
                                    <td colspan="7" style="padding: 3rem 0; text-align: center;">
                                        <div class="empty-state">
                                            <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                                            <p>Không tìm thấy đơn hàng nào thuộc bộ lọc này.</p>
                                        </div>
                                    </td>
                                </tr>
                            </c:when>
                            <c:otherwise>
                                <c:forEach var="order" items="${orders}">
                                    <tr>
                                        <td style="font-weight: 700; color: var(--color-primary);">#${order.id}</td>
                                        <td style="font-weight: 600;">${order.customerName}</td>
                                        <td><span class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; cursor: default;">${order.tableNumber}</span></td>
                                        <td>
                                            <span class="status-badge ${order.status.toLowerCase()}">
                                                <c:choose>
                                                    <c:when test="${order.status == 'PENDING'}"><i class="fas fa-hourglass-start"></i> Đơn Mới</c:when>
                                                    <c:when test="${order.status == 'MAKING'}"><i class="fas fa-sync fa-spin"></i> Đang Pha</c:when>
                                                    <c:when test="${order.status == 'COMPLETED'}"><i class="fas fa-check-circle"></i> Hoàn Thành</c:when>
                                                    <c:when test="${order.status == 'CANCELLED'}"><i class="fas fa-times-circle"></i> Đã Hủy</c:when>
                                                </c:choose>
                                            </span>
                                        </td>
                                        <td style="color: var(--color-text-secondary); font-size: 0.85rem;">
                                            <i class="far fa-clock"></i> ${order.formattedCreatedAt}
                                        </td>
                                        <td style="font-weight: 700;">
                                            <fmt:formatNumber value="${order.totalPrice}" pattern="#,###" /> VNĐ
                                        </td>
                                        <td>
                                            <a href="${pageContext.request.contextPath}/barista/order-detail?id=${order.id}" class="btn btn-secondary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">
                                                <i class="fas fa-eye"></i> Chi tiết & Prepare
                                            </a>
                                        </td>
                                    </tr>
                                </c:forEach>
                            </c:otherwise>
                        </c:choose>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <!-- Inject Context Path cho JS -->
    <script>
        window.contextPath = '${pageContext.request.contextPath}';
    </script>
    <!-- Custom JS -->
    <script src="${pageContext.request.contextPath}/views/assets/js/main.js"></script>
</body>
</html>